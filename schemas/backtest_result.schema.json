{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy_id", "strategy_version", "dataset_id", "period", "metrics", "equity_curve", "trade_log", "parameter_snapshot", "execution_assumptions", "reproducibility"],
  "properties": {
    "strategy_id": {"type": "string", "minLength": 1},
    "strategy_version": {"type": "string", "minLength": 1},
    "strategy_fingerprint": {"type": "string"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string"},
    "dataset_checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ending_position_open": {"type": "boolean"},
    "ending_unrealized_pnl": {"type": "number"},
    "experiment_id": {"type": "string"},
    "experiment_version": {"type": "string"},
    "experiment_fingerprint": {"type": "string"},
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["segment", "start", "end", "warmup_policy", "boundary_mode"],
      "properties": {
        "segment": {"enum": ["IS", "OOS"]},
        "start": {"type": "string"}, "end": {"type": "string"},
        "warmup_policy": {"type": "string"}, "boundary_mode": {"const": "flat_start"}
      }
    },
    "costs": {
      "type": "object", "additionalProperties": false,
      "required": ["commission_per_trade", "slippage_bps"],
      "properties": {
        "commission_per_trade": {"type": "number", "minimum": 0},
        "slippage_bps": {"type": "number", "minimum": 0},
        "source": {"enum": ["canonical_strategy", "experiment_override"]}
      }
    },
    "period": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}}},
    "metrics": {"type": "object", "required": ["trades", "total_return", "commission", "slippage"]},
    "equity_curve": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["timestamp", "equity"], "properties": {"timestamp": {"type": "string"}, "equity": {"type": "number"}}}},
    "trade_log": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["signal_time", "entry_time", "exit_time", "side", "quantity", "entry_price", "exit_price", "exit_reason", "pnl", "commission"], "properties": {"signal_time": {"type": "string"}, "entry_time": {"type": "string"}, "exit_time": {"type": "string"}, "side": {"enum": ["long", "short"]}, "quantity": {"type": "integer", "minimum": 1}, "entry_price": {"type": "number"}, "exit_price": {"type": "number"}, "exit_reason": {"enum": ["stop", "take_profit"]}, "pnl": {"type": "number"}, "commission": {"type": "number", "minimum": 0}}}},
    "parameter_snapshot": {"type": "object"},
    "execution_assumptions": {"type": "object", "additionalProperties": false, "required": ["signal_time", "fill_time", "same_bar_stop_target"], "properties": {"signal_time": {"const": "bar_close"}, "fill_time": {"const": "next_bar_open"}, "same_bar_stop_target": {"const": "stop_first"}}},
    "reproducibility": {"type": "object", "additionalProperties": false, "required": ["git_commit", "data_version", "data_checksum_sha256", "timestamp", "engine_version"], "properties": {"git_commit": {"type": "string", "minLength": 1}, "data_version": {"type": "string", "minLength": 1}, "data_checksum_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "timestamp": {"type": "string", "format": "date-time"}, "engine_version": {"type": "string", "minLength": 1}}}
  }
}
