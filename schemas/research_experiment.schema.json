{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id","experiment_version","description","dataset","strategies","research_window","evaluation","walk_forward","cost_sensitivity"],
  "properties": {
    "experiment_id": {"type":"string","pattern":"^[a-z0-9_-]+$"},
    "experiment_version": {"type":"string","pattern":"^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"},
    "description": {"type":"string"},
    "dataset": {"type":"object","additionalProperties":false,"required":["dataset_id","manifest_path"],"properties":{"dataset_id":{"type":"string"},"manifest_path":{"type":"string"}}},
    "strategies": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["strategy_id","strategy_version"],"properties":{"strategy_id":{"type":"string"},"strategy_version":{"type":"string"}}}},
    "research_window": {"$ref":"#/$defs/window"},
    "evaluation": {"type":"object","additionalProperties":false,"required":["in_sample","out_of_sample"],"properties":{"in_sample":{"$ref":"#/$defs/window"},"out_of_sample":{"$ref":"#/$defs/window"}}},
    "walk_forward": {"type":"object","additionalProperties":false,"required":["enabled","train_bars","test_bars","step_bars"],"properties":{"enabled":{"type":"boolean"},"train_bars":{"type":"integer","minimum":1},"test_bars":{"type":"integer","minimum":1},"step_bars":{"type":"integer","minimum":1}}},
    "cost_sensitivity": {"type":"object","additionalProperties":false,"required":["enabled","scenarios"],"properties":{"enabled":{"type":"boolean"},"scenarios":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","commission_multiplier","slippage_multiplier"],"properties":{"name":{"type":"string"},"commission_multiplier":{"type":"number","minimum":0},"slippage_multiplier":{"type":"number","minimum":0}}}}}}
  },
  "$defs": {"window":{"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"string"},"end":{"type":"string"}}}}
}
