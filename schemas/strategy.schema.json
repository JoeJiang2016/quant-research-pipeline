{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic strategy specification",
  "type": "object",
  "required": ["strategy_id", "strategy_version", "status", "dataset_id", "universe", "timeframe", "execution", "entry", "exit", "risk"],
  "properties": {
    "strategy_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "strategy_version": {"type": "string", "minLength": 1},
    "status": {"const": "candidate", "description": "Only candidate strategies may enter the deterministic backtest pipeline."},
    "dataset_id": {"type": "string", "minLength": 1},
    "universe": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "timeframe": {"type": "string", "enum": ["1m", "5m", "15m", "1h", "1d"]},
    "execution": {"type": "object", "required": ["signal_time", "fill_time", "order_type", "commission_per_trade", "slippage_bps"], "properties": {"signal_time": {"const": "bar_close"}, "fill_time": {"const": "next_bar_open"}, "order_type": {"enum": ["market", "limit"]}, "commission_per_trade": {"type": "number", "minimum": 0, "description": "USD per filled order"}, "slippage_bps": {"type": "number", "minimum": 0, "maximum": 1000, "description": "basis points applied adversely"}}},
    "entry": {"type": "object", "required": ["rule", "lookback_bars", "direction"], "properties": {"rule": {"enum": ["close_breakout"]}, "lookback_bars": {"type": "integer", "minimum": 2, "maximum": 500}, "direction": {"enum": ["long", "short"]}, "volume_multiplier": {"type": "number", "minimum": 0}}},
    "exit": {"type": "object", "required": ["stop_atr_multiple", "take_profit_atr_multiple", "atr_period"], "properties": {"stop_atr_multiple": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "take_profit_atr_multiple": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "atr_period": {"type": "integer", "minimum": 2, "maximum": 500}}},
    "risk": {"type": "object", "required": ["initial_equity", "risk_per_trade_pct"], "properties": {"initial_equity": {"type": "number", "exclusiveMinimum": 0, "description": "USD"}, "risk_per_trade_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "decimal fraction of current equity"}}},
    "evaluation": {"type": "object", "properties": {"in_sample_end": {"type": "string"}, "out_of_sample_start": {"type": "string"}, "walk_forward": {"type": "boolean"}}}
  }, "additionalProperties": false
}
